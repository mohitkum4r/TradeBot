# TradeBot Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# ============================================
# AUTHENTICATION & API CREDENTIALS
# ============================================

# Groww API Access Token (Required for LIVE mode)
# Get this from your Groww account settings
GROWW_ACCESS_TOKEN=your_groww_access_token_here

# Reddit API Credentials (Optional - for sentiment analysis)
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AutoTradeBot/0.3

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQLite database path (default: local file)
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For MySQL: mysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///autotrade.db

# ============================================
# TRADING MODE CONFIGURATION
# ============================================

# Trading mode: LIVE (real money) or PAPER (simulation)
# WARNING: Only use LIVE mode after thorough testing with PAPER mode
MODE=PAPER

# Market index to track (NIFTY or SENSEX)
MARKET_INDEX=NIFTY

# Enable backtesting mode (true/false)
BACKTEST=False

# Trading cycle interval in seconds (default: 3600 = 1 hour)
POLL_INTERVAL_SECONDS=3600

# ============================================
# CAPITAL & RISK MANAGEMENT
# ============================================

# Initial capital in INR (default: 100000 = 1 Lakh)
INITIAL_CAPITAL=100000.0

# Maximum exposure per trade as fraction of capital (0.0-1.0)
# Example: 0.2 = 20% of capital per trade
MAX_EXPOSURE_PER_TRADE=0.2

# Risk per trade as fraction of capital (0.0-1.0)
# Example: 0.01 = 1% risk per trade
RISK_PER_TRADE=0.01

# Stop loss percentage (0.0-1.0)
# Example: 0.05 = 5% stop loss
STOP_LOSS_PCT=0.05

# Take profit percentage (0.0-1.0)
# Example: 0.10 = 10% take profit
TAKE_PROFIT_PCT=0.10

# ============================================
# STOCK SELECTION
# ============================================

# Comma-separated list of stock symbols to trade
STOCKS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# NSE stock universe (optional, comma-separated)
# Leave empty to use default list
NSE_UNIVERSE=

# Enable multi-stock trading (true/false)
MULTI_STOCK_TRADING_ENABLED=true

# ============================================
# SENTIMENT ANALYSIS
# ============================================

# Enable sentiment analysis (true/false)
SENTIMENT_ANALYSIS_ENABLED=true

# Buy signal threshold (-1.0 to 1.0)
# Sentiment score must be above this to allow BUY
SENTIMENT_BUY_THRESHOLD=0.2

# Sell signal threshold (-1.0 to 1.0)
# Sentiment score must be below this to allow SELL
SENTIMENT_SELL_THRESHOLD=-0.2

# Ollama model for sentiment analysis
# Options: mistral, llama2, codellama, etc.
OLLAMA_MODEL=mistral

# ============================================
# TECHNICAL INDICATOR PARAMETERS
# ============================================

# ADX (Average Directional Index) period
ADX_PERIOD=14

# Trend strength thresholds
TREND_THRESHOLD=15
STRONG_TREND_THRESHOLD=35

# Volume breakout window
VOL_BREAKOUT_WINDOW=20

# RSI (Relative Strength Index) configuration
RSI_PERIOD=14
RSI_DIVERGENCE_WINDOW=14
RSI_BUY_THRESHOLD=40

# Moving Average windows
MA_SHORT_WINDOW=10
MA_LONG_WINDOW=30

# Pairs trading parameters
ENTRY_Z=1.5

# Volume confirmation multiplier
VOLUME_MULTIPLIER=1.2
VOLUME_CONFIRMATION_MULTIPLIER=1.0

# ADX confirmation threshold for sell signals
ADX_SELL_CONFIRM=25

# Cooldown period after loss (number of cycles)
COOLDOWN_AFTER_LOSS=5

# VWAP (Volume Weighted Average Price) window
VWAP_WINDOW=20

# Hedge threshold
HEDGE_THRESHOLD=0.05

# ============================================
# BACKTESTING CONFIGURATION
# ============================================

# Exchange (NSE or BSE)
EXCHANGE=NSE

# Segment (CASH or FNO)
SEGMENT=CASH

# Backtest period in days
BACKTEST_DAYS=60

# Backtest interval in minutes (1, 5, 10, 60, 240, 1440, 10080)
BACKTEST_INTERVAL_MINUTES=5

# Delay between API requests in seconds (to avoid rate limiting)
FETCH_DELAY_SECONDS=2.0

# Backtest date range (format: DD-MM-YYYY)
# Leave empty to use BACKTEST_DAYS from current date
BACKTEST_START_DATE=01-01-2024
BACKTEST_END_DATE=31-03-2024

# ============================================
# ADVANCED FEATURES
# ============================================

# Enable strategy examiner (true/false)
EXAMINER_ENABLED=true

# ============================================
# LOGGING & MONITORING (Future Enhancement)
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Log file path
# LOG_FILE=logs/autotrade.log

# ============================================
# NOTES & WARNINGS
# ============================================

# 1. NEVER commit this file with real credentials to version control
# 2. Always test with PAPER mode before using LIVE mode
# 3. Start with small INITIAL_CAPITAL and low RISK_PER_TRADE
# 4. Monitor the bot closely during initial LIVE trading
# 5. Set appropriate stop loss to limit potential losses
# 6. Ensure you understand SEBI regulations for algorithmic trading
# 7. Consider running extended paper trading (3+ months) before live trading
# 8. Keep API credentials secure and rotate them regularly
